<!-- ================= NAVBAR FIX SCRIPT ================= -->
<script>
    function initNavbar() {

        /* Feather icons reload */
        if (typeof feather !== "undefined") {
            feather.replace();
        }

        /* Hover dropdown fix */
        $(".onhover-dropdown").off("mouseenter").on("mouseenter", function () {
            $(this).children(".onhover-show-div").addClass("show");
        });

        $(".onhover-dropdown").off("mouseleave").on("mouseleave", function () {
            $(this).children(".onhover-show-div").removeClass("show");
        });

        /* Search box */
        $(".header-search").off("click").on("click", function () {
            $(".input-box").addClass("show");
            $(".search-box").focus();
        });

        $(".close-icon").off("click").on("click", function () {
            $(".input-box").removeClass("show");
            $(".search-box").val("");
        });

        /* Dark / Light mode */
        $(".mode").off("click").on("click", function () {
            $("body").toggleClass("dark-only");
        });
    }

    $(document).ready(function () {
        initNavbar();
    });

    // ASP.NET postback support
    if (typeof Sys !== "undefined") {
        Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
            initNavbar();
        });
    }
</script>

    </form>




 

