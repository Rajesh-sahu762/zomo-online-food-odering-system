                </a>
                <div class="nav-option order-md-2">
                    <div class="dropdown-button">
                        <div class="cart-button">
                            <span><%= CartCount %></span>

                            <i class="ri-shopping-cart-line text-white cart-bag"></i>
                        </div>
                        <div class="onhover-box">
                            <ul class="cart-list">
                           <asp:Repeater ID="rptCart" runat="server">
    <ItemTemplate>
        <li class="product-box-contain">
            <div class="drop-cart">
                <a href="#!" class="drop-image">
                    <img src="../assets/images/product//<%# Eval("MainImage") %>" />
                </a>
                <div class="drop-contain">
<h5><%# Eval("ItemName") %></h5>
                    <h6>
                        <span><%# Eval("Quantity") %> x </span>
    ₹<%# Eval("Price") %>
                    </h6>

                    <asp:LinkButton ID="LinkButton1" runat="server"
                        CommandArgument='<%# Eval("CartID") %>'
                        OnCommand="RemoveFromCart"
                        CssClass="close-button close_button">
                        <i class="fa-solid fa-xmark"></i>
                    </asp:LinkButton>
                </div>
            </div>
        </li>
    </ItemTemplate>
</asp:Repeater>

                            </ul>
                            <div class="price-box">
                                <h5>Total :</h5>
                               <h4 class="theme-color fw-semibold">
    ₹<%= CartTotal %>
</h4>

                            </div>
                            <div class="button-group">
                                <a href="checkout.aspx" class="btn btn-sm theme-btn w-100 d-block rounded-2">View
                                    Cart</a>
                            </div>
                        </div>
                    </div>
                   <!-- PROFILE / AUTH -->
<% if (IsLoggedIn) { %>
<div class="profile-part dropdown-button order-md-2">
    <img class="img-fluid profile-pic" src="<%= UserImage %>" alt="profile">
    <div>
        <h6 class="fw-normal">Hi, <%= UserName %></h6>
        <h5 class="fw-medium">My Account</h5>
    </div>

    <div class="onhover-box onhover-sm">
        <ul class="menu-list">
            <li><a class="dropdown-item" href="profile.aspx">Profile</a></li>
            <li><a class="dropdown-item" href="my-order.aspx">My Orders</a></li>
           
        </ul>
        <div class="bottom-btn">
            <asp:LinkButton ID="btnLogout" runat="server"
                CssClass="btn theme-btn w-100"
                OnClick="Logout_Click">
                Logout
            </asp:LinkButton>
        </div>
    </div>
</div>
<% } else { %>
<a href="signin.aspx" class="btn theme-btn ms-3">Sign In</a>
<% } %>

                </div>
